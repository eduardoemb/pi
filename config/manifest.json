{
  "version": 1,
  "ownership": {
    "package": ["generated Pi assets", "mcpServers.engram"],
    "user": ["defaultProvider", "defaultModel", "defaultProjectTrust", "enableInstallTelemetry", "five declared MCP entries", "declared models.json providers"]
  },
  "allowlist": [
    ".gitignore", ".github/PULL_REQUEST_TEMPLATE.md", ".github/workflows/validate.yml",
    "AGENTS.md", "README.md", "bootstrap/install.sh", "bootstrap/sync.py",
    "checks/final-core.sh", "checks/final-runtime.sh", "checks/final.sh",
    "checks/focused-core.sh", "checks/focused-operations.sh", "checks/focused-runtime.sh",
    "checks/hash_opencode.py", "checks/review_budget.py", "checks/test_sync.py",
    "config/manifest.json", "config/pi/mcp.user.json", "config/pi/models.user.json",
    "config/pi/settings.user.json", "docs/migration.md"
  ],
  "baseline": {
    "scope": "~/.config/opencode",
    "commands": ["python3 checks/hash_opencode.py --root ~/.config/opencode", "opencode --version"]
  }
}
